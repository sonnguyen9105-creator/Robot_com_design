size: 0.9em; }

.promotional-spotlight__link--show_on_mobile, .promotional-spotlight__link-=
icon { visibility: hidden; display: none; }

.promotional-spotlight__logo { margin-left: 0.15rem; }

.promotional-spotlight--COBRANDED_CREDIT_CARD { box-sizing: border-box; bac=
kground-color: var(--color-background-secondary,#f7f7f7); border-radius: 8p=
x; gap: 12px; padding: 8px 12px; }

.promotional-spotlight--COBRANDED_CREDIT_CARD .promotional-spotlight__messa=
ge { color: var(--color-foreground-primary,#191919); margin: 0px; font-size=
: 14px; line-height: 20px; }

.promotional-spotlight--COBRANDED_CREDIT_CARD .promotional-spotlight__messa=
ge strong { font-weight: 700; }

.promotional-spotlight__cobranded-icon { flex: 0 0 38px; width: 38px; heigh=
t: 24px; }

.promotional-spotlight__cobranded-card-art { flex: 0 0 auto; }

.promotional-spotlight__link--COBRANDED_CREDIT_CARD { color: var(--color-fo=
reground-primary,#191919); white-space: nowrap; flex: 0 0 auto; padding: 2p=
x 0px; font-size: 12px; line-height: 16px; text-decoration: underline; }

.promotional-spotlight__link--COBRANDED_CREDIT_CARD .promotional-spotlight_=
_link-icon { visibility: hidden; display: none; }

.promotional-spotlight .KLARNA_INSTALLMENT { margin-bottom: 4px; }

.promotional-spotlight__message { flex: 1 1 auto; padding-right: 2px; }

.promotional-spotlight__message > span { display: block; }

.promotional-spotlight__message span + .fake-link { margin-left: 0.25rem; }

.promotional-spotlight__message .fake-link { pointer-events: auto; }

.promotional-spotlight__start-image { width: 52px; height: 34px; }

@media (width <=3D 768px) {
  .promotional-spotlight { pointer-events: auto; justify-content: space-bet=
ween; align-items: center; }
  .promotional-spotlight__link--show_on_mobile, .promotional-spotlight__lin=
k-icon { visibility: inherit; display: block; }
  .promotional-spotlight__link-text { visibility: hidden; display: none; }
  .promotional-spotlight__link--COBRANDED_CREDIT_CARD { visibility: inherit=
; display: block; }
  .promotional-spotlight__link--COBRANDED_CREDIT_CARD .promotional-spotligh=
t__link-text { visibility: inherit; display: inline; }
  .promotional-spotlight__link--COBRANDED_CREDIT_CARD .promotional-spotligh=
t__link-icon, .promotional-spotlight .hide_on_mobile-text { visibility: hid=
den; display: none; }
