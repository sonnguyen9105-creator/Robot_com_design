  30% { transform: rotate(180deg); }
  50% { transform: rotate(180deg); }
  55% { transform: rotate(270deg); }
  75% { transform: rotate(270deg); }
  80% { transform: rotate(360deg); }
  100% { transform: rotate(360deg); }
