  45%, 50% { top: 16.8px; height: calc(14.4px); width: calc(14.4px); }
  90% { top: 0px; height: 12px; width: 12px; }
}

@keyframes vectorDotsXR {=20
  25% { right: 0px; }
  45%, 50% { right: 16.8px; width: calc(14.4px); height: calc(14.4px); }
  90% { right: 0px; height: 12px; width: 12px; }
}

@keyframes vectorDotsYR {=20
  25% { bottom: 0px; }
  45%, 50% { bottom: 16.8px; width: calc(14.4px); height: calc(14.4px); }
  90% { bottom: 0px; height: 12px; width: 12px; }
}

