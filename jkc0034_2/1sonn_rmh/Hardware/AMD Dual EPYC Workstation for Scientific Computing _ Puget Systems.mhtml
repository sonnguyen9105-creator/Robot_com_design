  .page .entry-header .entry-title, .page .entry-header .page-title, .page =
.page-header .entry-title, .page .page-header .page-title { font-size: 2.24=
rem; }
}

.page .entry-meta { font-variant: all-small-caps; font-weight: 400; }

.page .bx-wrapper .bx-next { right: -20px; }

.page .bx-wrapper .bx-prev { left: -20px; }

.background-puget-blue { background-color: rgb(19, 12, 100); }

nav.post-navigation { display: none; }

#disqus_thread { margin-top: 1rem; }

