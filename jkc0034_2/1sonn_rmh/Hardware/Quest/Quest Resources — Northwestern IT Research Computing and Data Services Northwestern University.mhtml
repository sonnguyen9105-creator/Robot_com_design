../images/next.png") right 48% no-repeat; opacity: 0; transition: opacity 0=
.6s; }

.lb-nav a.lb-next:hover { opacity: 1; }

.lb-dataContainer { margin: 0px auto; padding-top: 5px; width: 100%; border=
-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }

.lb-dataContainer::after { content: ""; display: table; clear: both; }

.lb-data { padding: 0px 4px; color: rgb(204, 204, 204); }

.lb-data .lb-details { width: 85%; float: left; text-align: left; line-heig=
ht: 1.1em; }

