.lb-data .lb-close { display: block; float: right; width: 30px; height: 30p=
x; background: url("../images/close.png") right top no-repeat; text-align: =
right; outline: 0px; opacity: 0.7; transition: opacity 0.2s; }

.lb-data .lb-close:hover { cursor: pointer; opacity: 1; }
