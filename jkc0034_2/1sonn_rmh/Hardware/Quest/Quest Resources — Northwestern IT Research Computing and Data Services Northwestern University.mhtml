n: 0px auto; border-radius: 4px; background-color: rgb(255, 255, 255); }

.lb-outerContainer::after { content: ""; display: table; clear: both; }

.lb-loader { top: 43%; height: 25%; width: 100%; }

.lb-cancel { display: block; width: 32px; height: 32px; margin: 0px auto; b=
ackground: url("../images/loading.gif") no-repeat; }

