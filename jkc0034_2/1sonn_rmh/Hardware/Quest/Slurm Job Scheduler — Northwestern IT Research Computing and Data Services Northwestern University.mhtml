<tr class=3D"row-odd"><th class=3D"head"><p class=3D"sd-card-text">Option</=
p></th>
<th class=3D"head"><p class=3D"sd-card-text">Slurm (sbatch)</p></th>
<th class=3D"head"><p class=3D"sd-card-text">Description</p></th>
</tr>
