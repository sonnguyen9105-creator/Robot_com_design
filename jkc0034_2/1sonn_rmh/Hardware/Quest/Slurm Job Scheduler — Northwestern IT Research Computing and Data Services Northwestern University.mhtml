 1-1.06 0Z"></path></svg></span></summary><div class=3D"sd-summary-content =
sd-card-body docutils">
<p class=3D"sd-card-text">This happens when the job can=E2=80=99t write to =
the output and/or error files so the job immediately dies.</p>
<hr class=3D"docutils">
<p class=3D"sd-card-text"><strong>Possible issue</strong>: The job script s=
pecifies a directory that does not exist</p>
<p class=3D"sd-card-text"><strong>Fix</strong>: Check the output and error =
files specified in the job submission script.</p>
<div class=3D"highlight-bash notranslate"><div class=3D"highlight"><pre id=
=3D"codecell62" tabindex=3D"-1"><span></span><span class=3D"c1">#SBATCH --o=
utput=3D/path/to/file/file_name</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell62">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">or</p>
<div class=3D"highlight-bash notranslate"><div class=3D"highlight"><pre id=
=3D"codecell63" tabindex=3D"-1"><span></span><span class=3D"c1">#SBATCH --e=
rror=3D/path/to/file/file_name</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell63">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<div class=3D"admonition tip">
<p class=3D"admonition-title">Tip</p>
<p class=3D"sd-card-text">Remember that file paths are relative to your cur=
rent working directory when you run <code class=3D"docutils literal notrans=
late"><span class=3D"pre">sbatch</span></code> to submit the job.  Use abso=
lute file paths starting with a <code class=3D"docutils literal notranslate=
"><span class=3D"pre">/</span></code> when in doubt.</p>
</div>
<hr class=3D"docutils">
<p class=3D"sd-card-text"><strong>Possible issue</strong>: A typo in the <c=
ode class=3D"docutils literal notranslate"><span class=3D"pre">--output=3D<=
/span></code> or <code class=3D"docutils literal notranslate"><span class=
=3D"pre">--error</span></code> part of the <code class=3D"docutils literal =
notranslate"><span class=3D"pre">#SBATCH</span></code> line</p>
<p class=3D"sd-card-text"><strong>Fix</strong>: Examine these lines closely=
 to make sure the syntax is correct</p>
<hr class=3D"docutils">
<p class=3D"sd-card-text"><strong>Possible issue</strong>: Providing a dire=
ctory, but not a file name, for output and/or error files</p>
<p class=3D"sd-card-text"><strong>Fix</strong>: Add a file name at the end =
of the specified path. For a file name in the format <code class=3D"docutil=
s literal notranslate"><span class=3D"pre">&lt;job_name&gt;.o&lt;job_id&gt;=
</span></code>, use</p>
<div class=3D"highlight-bash notranslate"><div class=3D"highlight"><pre id=
=3D"codecell64" tabindex=3D"-1"><span></span><span class=3D"c1">#SBATCH --o=
utput=3D/path/to/file/"%x.o%j"</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell64">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">Note if a separate error file is not specified, e=
rrors and output will both be written into the output file. To generate a s=
eparate error file, include the line:</p>
<div class=3D"highlight-bash notranslate"><div class=3D"highlight"><pre id=
=3D"codecell65" tabindex=3D"-1"><span></span><span class=3D"c1">#SBATCH --e=
rror=3D/path/to/file/"%x.e%j"</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell65">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
</div>
</details></section>
<section id=3D"troubleshooting-failed-jobs">
<h3>Troubleshooting Failed Jobs<a class=3D"headerlink" href=3D"https://rcds=
docs.it.northwestern.edu/systems/quest/user-guide/slurm/slurm.html?utm_sour=
ce=3Dchatgpt.com#troubleshooting-failed-jobs" title=3D"Link to this heading=
">#</a></h3>
<p>There are two common reasons for job failure outside of errors in the co=
de being executed:</p>
<details class=3D"sd-sphinx-override sd-dropdown sd-card sd-mb-3">
<summary class=3D"sd-summary-title sd-card-header">
<span class=3D"sd-summary-icon"><svg version=3D"1.1" width=3D"1.0em" height=
=3D"1.0em" class=3D"sd-octicon sd-octicon-note" viewBox=3D"0 0 16 16" aria-=
hidden=3D"true"><path d=3D"M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.78=
4 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25Zm1.75=
-.25a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v=
-8.5a.25.25 0 0 0-.25-.25ZM3.5 6.25a.75.75 0 0 1 .75-.75h7a.75.75 0 0 1 0 1=
.5h-7a.75.75 0 0 1-.75-.75Zm.75 2.25h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1 0=
-1.5Z"></path></svg></span><span class=3D"sd-summary-text">Job Exceeded Req=
uest Time or Memory</span><span class=3D"sd-summary-state-marker sd-summary=
-chevron-right"><svg version=3D"1.1" width=3D"1.5em" height=3D"1.5em" class=
=3D"sd-octicon sd-octicon-chevron-right" viewBox=3D"0 0 24 24" aria-hidden=
=3D"true"><path d=3D"M8.72 18.78a.75.75 0 0 1 0-1.06L14.44 12 8.72 6.28a.75=
1.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018l6.25 6.25a.75.75 0 0 1 0 1.=
06l-6.25 6.25a.75.75 0 0 1-1.06 0Z"></path></svg></span></summary><div clas=
s=3D"sd-summary-content sd-card-body docutils">
<p class=3D"sd-card-text">Besides errors in your script or hardware failure=
, your job may be
aborted by the system if it is still running when the wall time limit you
requested (or the upper wall time limit for the partition) is reached.
You will see a <code class=3D"docutils literal notranslate"><span class=3D"=
pre">TIMEOUT</span></code> state for these jobs when running <code class=3D=
"docutils literal notranslate"><span class=3D"pre">sacct</span> <span class=
=3D"pre">-X</span></code>.</p>
<p class=3D"sd-card-text">If you use more cores than you requested, the sys=
tem will stop the job. This can happen with programs that are multi-threade=
d. Similarly, if the job exceeds the requested memory, the job will be term=
inated. Due to this, it is important to profile your code for the memory re=
quirement.</p>
<div class=3D"admonition note">
<p class=3D"admonition-title">Note</p>
<p class=3D"sd-card-text">If you do not set the number of nodes/cores, memo=
ry or time in your job submission script, the default values will be assign=
ed by the scheduler.</p>
</div>
</div>
</details><details class=3D"sd-sphinx-override sd-dropdown sd-card sd-mb-3"=
>
<summary class=3D"sd-summary-title sd-card-header">
<span class=3D"sd-summary-icon"><svg version=3D"1.1" width=3D"1.0em" height=
=3D"1.0em" class=3D"sd-octicon sd-octicon-note" viewBox=3D"0 0 16 16" aria-=
hidden=3D"true"><path d=3D"M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.78=
4 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25Zm1.75=
-.25a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v=
-8.5a.25.25 0 0 0-.25-.25ZM3.5 6.25a.75.75 0 0 1 .75-.75h7a.75.75 0 0 1 0 1=
.5h-7a.75.75 0 0 1-.75-.75Zm.75 2.25h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1 0=
-1.5Z"></path></svg></span><span class=3D"sd-summary-text">Out of Disk Spac=
e</span><span class=3D"sd-summary-state-marker sd-summary-chevron-right"><s=
vg version=3D"1.1" width=3D"1.5em" height=3D"1.5em" class=3D"sd-octicon sd-=
octicon-chevron-right" viewBox=3D"0 0 24 24" aria-hidden=3D"true"><path d=
=3D"M8.72 18.78a.75.75 0 0 1 0-1.06L14.44 12 8.72 6.28a.751.751 0 0 1 .018-=
1.042.751.751 0 0 1 1.042-.018l6.25 6.25a.75.75 0 0 1 0 1.06l-6.25 6.25a.75=
.75 0 0 1-1.06 0Z"></path></svg></span></summary><div class=3D"sd-summary-c=
ontent sd-card-body docutils">
<p class=3D"sd-card-text">Your job could fail if you exceed your storage qu=
ota (limit) in your home or projects directory. Your job could also fail if=
 you exceed the number of files allowed in your home, projects, or scratch =
directory, even when storage space remains available.</p>
<p class=3D"sd-card-text">Check how much space and how many files you are u=
sing in your home directory with</p>
<div class=3D"highlight-console notranslate"><div class=3D"highlight"><pre =
id=3D"codecell66" tabindex=3D"-1"><span></span><span class=3D"gp">$ </span>=
homedu
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell66">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">or</p>
<div class=3D"highlight-console notranslate"><div class=3D"highlight"><pre =
id=3D"codecell67" tabindex=3D"-1"><span></span><span class=3D"gp">$ </span>=
du<span class=3D"w"> </span>-h<span class=3D"w"> </span>--max-depth<span cl=
ass=3D"o">=3D</span><span class=3D"m">0</span><span class=3D"w"> </span>~
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell67">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">Check how much space and how many files are used =
in your projects directory of your storage resource (identified by your acc=
ount ID) with</p>
<div class=3D"highlight-console notranslate"><div class=3D"highlight"><pre =
id=3D"codecell68" tabindex=3D"-1"><span></span><span class=3D"gp">$ </span>=
checkstorage<span class=3D"w"> </span>&lt;account_id&gt;
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell68">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">Check how much space and how many files are used =
in your scratch directory with</p>
<div class=3D"highlight-console notranslate"><div class=3D"highlight"><pre =
id=3D"codecell69" tabindex=3D"-1"><span></span><span class=3D"gp">$ </span>=
scratchdu<span class=3D"w"> </span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell69">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">To reduce your file count, combine many small fil=
es into archives such as <code class=3D"docutils literal notranslate"><span=
 class=3D"pre">.tar</span></code> or <code class=3D"docutils literal notran=
slate"><span class=3D"pre">.zip</span></code>, or remove files you no longe=
r need. For more information, see the <a class=3D"reference internal" href=
=3D"https://rcdsdocs.it.northwestern.edu/systems/quest/user-guide/filesyste=
m/filesystem.html#home-directories"><span class=3D"std std-ref">Home</span>=
</a>, <a class=3D"reference internal" href=3D"https://rcdsdocs.it.northwest=
ern.edu/systems/quest/user-guide/filesystem/filesystem.html#allocation-dire=
ctories"><span class=3D"std std-ref">Projects Space</span></a>, and <a clas=
s=3D"reference internal" href=3D"https://rcdsdocs.it.northwestern.edu/syste=
ms/quest/user-guide/filesystem/filesystem.html#scratch-space"><span class=
=3D"std std-ref">Scratch Space</span></a> sections of the Quest filesystem =
documentation.</p>
</div>
</details></section>
<section id=3D"troubleshooting-memory-requests">
<h3>Troubleshooting Memory Requests<a class=3D"headerlink" href=3D"https://=
