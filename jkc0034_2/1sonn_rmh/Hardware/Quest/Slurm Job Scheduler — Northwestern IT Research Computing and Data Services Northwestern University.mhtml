-8.5a.25.25 0 0 0-.25-.25ZM3.5 6.25a.75.75 0 0 1 .75-.75h7a.75.75 0 0 1 0 1=
.5h-7a.75.75 0 0 1-.75-.75Zm.75 2.25h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1 0=
-1.5Z"></path></svg></span><span class=3D"sd-summary-text">Time</span><span=
 class=3D"sd-summary-state-marker sd-summary-chevron-right"><svg version=3D=
"1.1" width=3D"1.5em" height=3D"1.5em" class=3D"sd-octicon sd-octicon-chevr=
on-right" viewBox=3D"0 0 24 24" aria-hidden=3D"true"><path d=3D"M8.72 18.78=
