m" height=3D"1.0em" viewBox=3D"0 0 16 16" aria-hidden=3D"true" style=3D"dis=
play: inline-block; vertical-align: middle; fill: currentColor;"><path d=3D=
"M3.75 2h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v8.5c0 .138.112.25.=
