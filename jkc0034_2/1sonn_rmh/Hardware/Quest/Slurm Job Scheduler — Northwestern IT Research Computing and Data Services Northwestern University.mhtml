-1.06 0Z"></path></svg></span></summary><div class=3D"sd-summary-content sd=
-card-body docutils">
<p class=3D"sd-card-text">Job arrays can be used to submit multiple jobs at=
 once that use the same job submission script. This can be useful if you wa=
nt to run the same script multiple times with different input parameters.</=
p>
<p class=3D"sd-card-text">A job array is created with the addition of the <=
code class=3D"docutils literal notranslate"><span class=3D"pre">--array</sp=
an></code> option to a job submission script, and using the <code class=3D"=
docutils literal notranslate"><span class=3D"pre">$SLURM_ARRAY_TASK_ID</spa=
n></code> environment variable to keep track of which job in the array is r=
unning.  It is useful to update the job name and output files to incorporat=
e the array ID in the filenames so that a separate log file is created for =
each job.</p>
<p class=3D"sd-card-text">Example submission file: <code class=3D"docutils =
literal notranslate"><span class=3D"pre">jobsubmission.sh</span></code></p>
<div class=3D"highlight-bash notranslate"><div class=3D"highlight"><pre id=
=3D"codecell44" tabindex=3D"-1"><span></span><span class=3D"ch">#!/bin/bash=
</span>
<span class=3D"c1">#SBATCH --account=3D&lt;account_id&gt;  ## Required: you=
r Slurm account name, i.e. eXXXX, pXXXX or bXXXX</span>
<span class=3D"c1">#SBATCH --partition=3D&lt;partition&gt; ## Required: buy=
in, short, normal, long, gengpu, genhimem, etc.</span>
<span class=3D"c1">#SBATCH --time=3D&lt;HH:MM:SS&gt;       ## Required: How=
 long will the job need to run?  Limits vary by partition</span>
<span class=3D"c1">#SBATCH --nodes=3D&lt;#&gt;             ## How many comp=
uters/nodes do you need? Usually 1</span>
<span class=3D"c1">#SBATCH --ntasks-per-node=3D&lt;#&gt;   ## How many CPUs=
 or processors do you need on per computer/node? (default value 1)</span>
<span class=3D"c1">#SBATCH --mem=3D&lt;#G&gt;              ## How much RAM =
do you need per computer/node? G =3D gigabytes</span>
<span class=3D"c1">#SBATCH --array=3D0-9             ## number of jobs to r=
un: here, 10 jobs, labelled 0 through 9 </span>
<span class=3D"c1">#SBATCH --job-name=3D"sample_job_\${SLURM_ARRAY_TASK_ID}=
"   ## use the array id in the name of the job</span>
<span class=3D"c1">#SBATCH --output=3Dsample_job.%A_%a.out                 =
    ## use the jobid (%A) and the array index (%a) to name the log files</s=
pan>

module<span class=3D"w"> </span>purge<span class=3D"w"> </span>all
module<span class=3D"w"> </span>load<span class=3D"w"> </span>python-anacon=
da3
<span class=3D"nb">source</span><span class=3D"w"> </span>activate<span cla=
ss=3D"w"> </span>/projects/intro/envs/slurm-py37-test

<span class=3D"c1"># Read in the different input arguments from a file inpu=
t_args.txt</span>
<span class=3D"nv">IFS</span><span class=3D"o">=3D</span><span class=3D"s1"=
>$'\n'</span><span class=3D"w"> </span><span class=3D"nb">read</span><span =
class=3D"w"> </span>-d<span class=3D"w"> </span><span class=3D"s1">''</span=
><span class=3D"w"> </span>-r<span class=3D"w"> </span>-a<span class=3D"w">=
 </span>input_args<span class=3D"w"> </span>&lt;<span class=3D"w"> </span>i=
nput_args.txt

python<span class=3D"w"> </span>slurm_test.py<span class=3D"w"> </span>--fi=
lename<span class=3D"w"> </span><span class=3D"si">${</span><span class=3D"=
nv">input_args</span><span class=3D"p">[</span><span class=3D"nv">$SLURM_AR=
RAY_TASK_ID</span><span class=3D"p">]</span><span class=3D"si">}</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell44">
      <svg xmlns=3D"http://www.w3.org/2000/svg" class=3D"icon icon-tabler i=
con-tabler-copy" width=3D"44" height=3D"44" viewBox=3D"0 0 24 24" stroke-wi=
dth=3D"1.5" stroke=3D"#000000" fill=3D"none" stroke-linecap=3D"round" strok=
e-linejoin=3D"round">
  <title>Copy to clipboard</title>
  <path stroke=3D"none" d=3D"M0 0h24v24H0z" fill=3D"none"></path>
  <rect x=3D"8" y=3D"8" width=3D"12" height=3D"12" rx=3D"2"></rect>
  <path d=3D"M16 8v-2a2 2 0 0 0 -2 -2h-8a2 2 0 0 0 -2 2v8a2 2 0 0 0 2 2h2">=
</path>
</svg>
    </button></div>
</div>
<p class=3D"sd-card-text">This script will create 10 jobs, labelled with th=
e job array indices 0 through 9.  Each job runs the same Python script, <co=
de class=3D"docutils literal notranslate"><span class=3D"pre">slurm_test.py=
</span></code> using different input arguments from the file <code class=3D=
"docutils literal notranslate"><span class=3D"pre">input_args.txt</span></c=
ode>.</p>
<p class=3D"sd-card-text"><code class=3D"docutils literal notranslate"><spa=
n class=3D"pre">input_args.txt</span></code> contains:</p>
<div class=3D"highlight-default notranslate"><div class=3D"highlight"><pre =
id=3D"codecell45" tabindex=3D"-1"><span></span><span class=3D"n">filename1<=
/span><span class=3D"o">.</span><span class=3D"n">txt</span>
<span class=3D"n">filename2</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename3</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename4</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename5</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename6</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename7</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename8</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename9</span><span class=3D"o">.</span><span class=3D"=
n">txt</span>
<span class=3D"n">filename10</span><span class=3D"o">.</span><span class=3D=
"n">txt</span>
</pre><button class=3D"copybtn o-tooltip--left" data-tooltip=3D"Copy" data-=
clipboard-target=3D"#codecell45">
