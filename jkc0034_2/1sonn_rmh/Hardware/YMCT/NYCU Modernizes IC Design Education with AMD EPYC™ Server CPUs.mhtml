			<source media=3D"(max-width: 575px)" srcset=3D"/content/dam/amd/en/image=
s/logos/partners/case-studies/5273637-nycu-case-study/5273637-nycu-case-stu=
dy-1.jpg">
			<source media=3D"(max-width: 1199px)" srcset=3D"/content/dam/amd/en/imag=
es/logos/partners/case-studies/5273637-nycu-case-study/5273637-nycu-case-st=
udy-1.jpg">
			<source media=3D"(max-width: 1920px)" srcset=3D"/content/dam/amd/en/imag=
