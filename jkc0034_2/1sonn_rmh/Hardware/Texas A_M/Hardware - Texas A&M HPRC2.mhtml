<td>96</td>
<td>96</td>
</tr>
<tr>
<td>Cores per Node</td>
<td>192</td>
<td>192</td>
</tr>
<tr>
<td>Clock rate (Base/Max Boost)</td>
<td>2.4 GHz / 3.7 GHz</td>
<td>2.4 GHz / 3.7 GHz</td>
</tr>
<tr>
<td>Memory</td>
<td>384 GB DDR5-4800</td>
<td>768 GB DDR5-4800</td>
</tr>
<tr>
<td>Cache</td>
<td>384 MB</td>
<td>384 MB</td>
</tr>
<tr>
