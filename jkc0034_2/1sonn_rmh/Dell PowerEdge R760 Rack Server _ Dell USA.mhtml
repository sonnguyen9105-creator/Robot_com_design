 }

#sec-text-if.crypto { height: 80px; }

#sec-text-if.adaptive, #sec-text-if.behavioral { height: 85px; }

#sec-text-container { overflow: hidden; padding: 5px 10px; }

#sec-cpt-if { overflow: hidden; display: block; margin: 0px auto; width: 32=
0px; height: 500px; }

