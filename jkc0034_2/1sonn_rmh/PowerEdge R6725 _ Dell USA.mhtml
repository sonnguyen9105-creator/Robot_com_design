  #sec-container { position: static; transform: none; background-color: rgb=
(255, 255, 255); border-radius: 0px; box-shadow: none; min-width: auto; wid=
th: 100%; }
  #sec-text-container { padding: 10px; }
  #sec-if-container { width: 100%; }
  #sec-cpt-if { width: 100%; max-width: 320px; }
}
